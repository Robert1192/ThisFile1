@using ProjectWebsite10032026.Models
@using Microsoft.EntityFrameworkCore
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">Mercantec</a>
    </div>
</div>

<!-- Sidebar removed as requested -->
<nav class="navbar navbar-expand-lg">
    <div class="container-fluid">
        <NavLink class="nav-link" href="/">Links</NavLink>
        <NavLink class="nav-link" href="/downloads">Downloads</NavLink>
        <NavLink class="nav-link" href="/counter">Counter</NavLink>
        <NavLink class="nav-link" href="/weather">Weather</NavLink>
    </div>
</nav>

@code {
    List<Download>? downloads;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            downloads = await db.Downloads.OrderBy(d => EF.Property<string>(d, nameof(Download.Description))).ToListAsync();
        }
        catch
        {
            downloads = new List<Download>();
        }
    }
}
