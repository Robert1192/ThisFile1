@using ProjectWebsite10032026.Models
@using Microsoft.EntityFrameworkCore
@inject ProjectWebsite10032026.Data.AppDbContext Db

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MERCANTEC</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="links">
                <span class="bi bi-link-45deg"></span>
                Links
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pdfs">
                <span class="bi bi-file-earmark-pdf"></span>
                PDF Files
            </NavLink>
        </div>

        @if (downloads is not null && downloads.Any())
        {
            <div class="nav-item px-3 mt-2">
                <div class="nav-header text-muted px-2">All PDFs</div>
                @foreach (var d in downloads)
                {
                    <NavLink class="nav-link child-link" href="@($"/pdfviewer/{d.ID}")">
                        @(!string.IsNullOrWhiteSpace(d.Description) ? d.Description : d.FileName)
                    </NavLink>
                }
            </div>
        }

    </nav>
</div>

@code {
    List<Download>? downloads;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            downloads = await Db.Downloads.OrderBy(d => d.Description).ToListAsync();
        }
        catch
        {
            downloads = new List<Download>();
        }
    }
}
