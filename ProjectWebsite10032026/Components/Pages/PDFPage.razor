@using ProjectWebsite10032026.Data
@page "/pdf"
@page "/pdffiles"
@using ProjectWebsite10032026.Models
@using Microsoft.EntityFrameworkCore
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory

<h3>PDF Files</h3>

<div class="mb-3">
    <NavLink class="btn btn-outline-primary" href="/">Home</NavLink>
</div>

@if (downloads == null || downloads.Count == 0)
{
    <p>No files found.</p>
}
else
{
    @foreach (var item in downloads)
    {
        <div class="card mb-2">
            <a href="@item.FilePath" target="_blank">
                @item.Description
            </a>
        </div>
    }
}

@code {
    List<Download> downloads = new();

    protected override async Task OnInitializedAsync()
    {
        using var db = DbFactory.CreateDbContext();
        downloads = await db.Downloads
            .OrderBy(d => d.Description ?? string.Empty)
            .ToListAsync();
    }
}