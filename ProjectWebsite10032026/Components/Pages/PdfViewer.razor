@page "/pdfviewer/{Id:int}"
@using ProjectWebsite10032026.Models
@inject ProjectWebsite10032026.Data.AppDbContext Db
@inject NavigationManager Navigation

@code {
    [Parameter]
    public int Id { get; set; }

    Download download;

    protected override async Task OnInitializedAsync()
    {
        download = await Db.Downloads.FindAsync(Id);
        if (download is null)
        {
            // go back to pdfs list if not found
            Navigation.NavigateTo("/pdfs");
        }
    }
}

@if (download is null)
{
    <p>Loading...</p>
}
else
{
    <div style="height:100vh;">
        <iframe src="@download.FilePath" style="width:100%;height:100%;border:0"></iframe>
    </div>
}