@using ProjectWebsite10032026.Data
@using ProjectWebsite10032026.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory

@page "/"

<!-- 🔵 HEADER -->
<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h3 class="m-0">Links</h3>

    <NavLink class="btn btn-outline-primary" href="/downloads">
        Downloads
    </NavLink>
</div>

<!-- 🔵 ADD LINK FORM -->
<div class="card p-3 mb-3">
    <h5>Add new link</h5>

    <input class="form-control mb-2"
           placeholder="Category"
           @bind="newCategory" />

    <input class="form-control mb-2"
           placeholder="Description"
           @bind="newDescription" />

    <input class="form-control mb-2"
           placeholder="URL"
           @bind="newUrl" />

    <button class="btn btn-primary"
            @onclick="AddLinkAsync">
        Add Link
    </button>
</div>

<!-- 🔵 LIST -->
@if (links == null)
{
    <p>Loading...</p>
}
else if (links.Count == 0)
{
    <p>No links found.</p>
}
else
{
    <div class="list-group">
        @foreach (var link in links)
        {
            <a class="list-group-item list-group-item-action"
               href="@link.Url"
               target="_blank"
               rel="noopener noreferrer">

                <strong>
                    @(string.IsNullOrWhiteSpace(link.Category) ? "Link" : link.Category)
                </strong>

                <div>
                    @(string.IsNullOrWhiteSpace(link.Description)
                        ? link.Url
                        : link.Description)
                </div>
            </a>
        }
    </div>
}

@code {
    private List<Link> links = new();

    private string? newCategory;
    private string? newDescription;
    private string? newUrl;

    protected override async Task OnInitializedAsync()
    {
        await EnsureSeedLinksAsyncSafe();
        await LoadLinks();
    }

    private async Task LoadLinks()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            links = await db.Links
                .AsNoTracking()
                .OrderBy(l => EF.Property<string>(l, nameof(Link.Category)) ?? "")
                .ThenBy(l => EF.Property<string>(l, nameof(Link.Description)) ?? "")
                .ToListAsync();
        }
        catch
        {
            links = new();
        }
    }

    private async Task AddLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(newUrl))
            return;

        try
        {
            using var db = DbFactory.CreateDbContext();

            var link = new Link
            {
                Category = newCategory,
                Description = newDescription,
                Url = newUrl
            };

            db.Links.Add(link);
            await db.SaveChangesAsync();

            newCategory = "";
            newDescription = "";
            newUrl = "";

            await LoadLinks();
        }
        catch
        {
            // optional: add logging here
        }
    }

    private async Task EnsureSeedLinksAsyncSafe()
    {
        using var db = DbFactory.CreateDbContext();

        if (await db.Links.AnyAsync())
            return;

        db.Links.AddRange(
            new Link
            {
                Category = "Guidance",
                Description = "Bliv godkendt som lærested",
                Url = "https://iu.dk/skoler-og-virksomheder/oplaering/bliv-godkendt-som-laerested"
            },
            new Link
            {
                Category = "Regulation",
                Description = "Data- og kommunikationsuddannelsen",
                Url = "https://www.retsinformation.dk/eli/lta/2026/182"
            }
        );

        await db.SaveChangesAsync();
    }
}