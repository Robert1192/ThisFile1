@using ProjectWebsite10032026.Data
@using ProjectWebsite10032026.Models
@page "/"
@using Microsoft.EntityFrameworkCore
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory
@inject Microsoft.Extensions.Logging.ILogger<ProjectWebsite10032026.Components.Pages.Links> Logger

<h3>Links</h3>

<div class="mb-4 add-form">
    <label for="newLink" class="form-label">Add new link</label>
    <div class="input-group">
        <input id="newLink" class="form-control" placeholder="Description" @bind="newLinkDesc" />
        <input class="form-control" placeholder="Url" @bind="newLinkUrl" />
        <button type="button" class="btn btn-primary" @onclick="AddLink" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <span>Add</span>
            }
        </button>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-2 alert alert-@messageType p-2">@message</div>
    }
</div>

<p>List of useful links:</p>

@if (links == null || links.Count == 0)
{
    <p>No links found.</p>
}
else
{
    @foreach (var l in links)
    {
        <div class="card link-card">
            <a href="@l.Url" target="_blank" rel="noopener noreferrer">@l.Description</a>
        </div>
    }
}

<div class="mt-3">
    <NavLink class="btn btn-outline-primary" href="/downloads">Downloads</NavLink>
</div>

@code {
    private List<ProjectWebsite10032026.Models.Link> links = new();
    private string newLinkDesc = string.Empty;
    private string newLinkUrl = string.Empty;
    private bool isSaving = false;
    private string message = string.Empty;
    private string messageType = "info"; // "info" or "danger"

    protected override async Task OnInitializedAsync()
    {
        // Ensure seed data exists first so LoadLinks will include seeded items.
        await EnsureSeedLinksAsync();
        await LoadLinks();
    }

    private async Task LoadLinks()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            links = await db.Links
                .OrderBy(l => l.Description ?? string.Empty)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            // Log and recover with an empty list
            Logger?.LogError(ex, "Failed to load Links from database");
            links = new List<ProjectWebsite10032026.Models.Link>();
        }
    }

    // Ensure the two requested links exist in the database; insert if missing.
    private async Task EnsureSeedLinksAsync()
    {
        var seed = new[] {
            new ProjectWebsite10032026.Models.Link { Description = "Bliv godkendt som lærested", Url = "https://iu.dk/skoler-og-virksomheder/oplaering/bliv-godkendt-som-laerested" },
            new ProjectWebsite10032026.Models.Link { Description = "Bekendtgørelse om Data- og kommunikationsuddannelsen", Url = "https://www.retsinformation.dk/eli/lta/2026/182" }
        };

        try
        {
            using var db = DbFactory.CreateDbContext();
            bool changed = false;
            foreach (var s in seed)
            {
                var exists = await db.Links.AnyAsync(x => x.Url == s.Url);
                if (!exists)
                {
                    db.Links.Add(s);
                    changed = true;
                }
            }
            if (changed)
            {
                await db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Failed to seed default links");
        }
    }

    private async Task AddLink()
    {
        message = string.Empty;
        if (string.IsNullOrWhiteSpace(newLinkDesc) || string.IsNullOrWhiteSpace(newLinkUrl))
        {
            messageType = "danger";
            message = "Please fill both fields.";
            return;
        }

        // basic URL validation
        if (!Uri.TryCreate(newLinkUrl, UriKind.Absolute, out var parsed) || !(parsed.Scheme == Uri.UriSchemeHttp || parsed.Scheme == Uri.UriSchemeHttps))
        {
            messageType = "danger";
            message = "Please enter a valid http(s) URL.";
            return;
        }

        var link = new ProjectWebsite10032026.Models.Link { Description = newLinkDesc, Url = newLinkUrl };
        // optimistic UI update
        links.Insert(0, link);
        StateHasChanged();
        isSaving = true;
        try
        {
            using var db = DbFactory.CreateDbContext();
            db.Links.Add(link);
            await db.SaveChangesAsync();
            newLinkDesc = string.Empty;
            newLinkUrl = string.Empty;
            messageType = "info";
            message = "Link added.";
        }
        catch (Exception ex)
        {
            Logger?.LogError(ex, "Failed to add link");
            // rollback optimistic update
            links.Remove(link);
            messageType = "danger";
            message = "Failed to add link. It was not saved to the database.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
