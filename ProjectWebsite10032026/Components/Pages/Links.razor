@using ProjectWebsite10032026.Data
@using ProjectWebsite10032026.Models
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Authorization
@inject IDbContextFactory<AppDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@page "/"

<!-- 🔵 HEADER -->
<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h3 class="m-0">Links</h3>
    <div class="d-flex align-items-center gap-3">
        <AuthorizeView>
            <Authorized Context="authState">
                <span class="small text-muted">@authState.User.Identity?.Name</span>
                <form method="post" action="/Account/Logout" style="display:inline">
                    <button type="submit" class="btn btn-sm btn-outline-secondary">Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo("/login")'>Login</button>
            </NotAuthorized>
        </AuthorizeView>
        <NavLink class="btn btn-outline-primary" href="/downloads">Downloads</NavLink>
    </div>
</div>

<!-- 🔵 ADD LINK FORM -->
<div class="card p-3 mb-3">
    <AuthorizeView Roles="Admin">
        <Authorized>
            <h5>Add new link</h5>

            <input class="form-control mb-2"
                   placeholder="Category"
                   @bind="newCategory" />

            <input class="form-control mb-2"
                   placeholder="Description"
                   @bind="newDescription" />

            <input class="form-control mb-2"
                   placeholder="URL"
                   @bind="newUrl" />

            <button class="btn btn-primary" @onclick="AddLinkAsync">
                Add Link
            </button>
        </Authorized>
        <NotAuthorized>
            <div class="d-flex gap-2 align-items-center">
                <h6 class="text-muted m-0">Log in as admin to add links.</h6>
                <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo("/login")'>Log in</button>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<!-- 🔵 LIST -->
@if (links == null)
{
    <p>Loading...</p>
}
else if (links.Count == 0)
{
    <p>No links found.</p>
}
else
{
    <div class="list-group">
        @foreach (var link in links)
        {
            <a class="list-group-item list-group-item-action"
               href="@link.Url"
               target="_blank"
               rel="noopener noreferrer"
               style="border-left: 4px solid #0d6efd; color: #0d6efd; text-decoration: none;">
                <div style="font-weight: 500;">
                    @(string.IsNullOrWhiteSpace(link.Description) ? link.Url : link.Description)
                </div>
                <div style="font-size: 0.8rem; color: #6c757d;">
                    @(string.IsNullOrWhiteSpace(link.Category) ? "" : link.Category)
                </div>
            </a>
        }
    </div>
}

<!-- 🔵 FOOTER -->
<div class="border-top mt-4 pt-3 text-muted small text-center">
    Mercantec, H.C. Andersens Vej 9, 8800 Viborg &nbsp;|&nbsp; Tlf. +45 89 50 33 00 &nbsp;|&nbsp;
    <a href="mailto:mikp@mercantec.dk">mikp@mercantec.dk</a>
</div>

@code {
    private List<Link> links = new();

    private string? newCategory;
    private string? newDescription;
    private string? newUrl;

    protected override async Task OnInitializedAsync()
    {
        await EnsureSeedLinksAsyncSafe();
        await LoadLinks();
    }

    private async Task LoadLinks()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            links = await db.Links
                .AsNoTracking()
                .OrderBy(l => EF.Property<string>(l, nameof(Link.Category)) ?? "")
                .ThenBy(l => EF.Property<string>(l, nameof(Link.Description)) ?? "")
                .ToListAsync();
        }
        catch
        {
            links = new();
        }
    }

    private async Task AddLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(newUrl))
            return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.IsInRole("Admin"))
            return;

        try
        {
            using var db = DbFactory.CreateDbContext();
            var link = new Link
            {
                Category = newCategory,
                Description = newDescription,
                Url = newUrl
            };
            db.Links.Add(link);
            await db.SaveChangesAsync();

            newCategory = "";
            newDescription = "";
            newUrl = "";

            await LoadLinks();
        }
        catch { }
    }

    private async Task EnsureSeedLinksAsyncSafe()
    {
        using var db = DbFactory.CreateDbContext();
        if (await db.Links.AnyAsync())
            return;

        db.Links.AddRange(
            new Link
            {
                Category = "Guidance",
                Description = "Bliv godkendt som lærested",
                Url = "https://iu.dk/skoler-og-virksomheder/oplaering/bliv-godkendt-som-laerested"
            },
            new Link
            {
                Category = "Regulation",
                Description = "Data- og kommunikationsuddannelsen",
                Url = "https://www.retsinformation.dk/eli/lta/2026/182"
            }
        );
        await db.SaveChangesAsync();
    }
}