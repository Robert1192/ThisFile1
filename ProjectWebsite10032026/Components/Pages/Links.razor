@using ProjectWebsite10032026.Data
@using ProjectWebsite10032026.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory

@page "/"

<h3>Links</h3>

@if (links == null)
{
    <p>Loading...</p>
}
else if (links.Count == 0)
{
    <p>No links found.</p>
}
else
{
    <div class="list-group">
        @foreach (var link in links)
        {
            <a class="list-group-item list-group-item-action"
               href="@link.Url"
               target="_blank"
               rel="noopener noreferrer">

                <strong>@(string.IsNullOrWhiteSpace(link.Category) ? "Link" : link.Category)</strong>

                <div>
                    @(string.IsNullOrWhiteSpace(link.Description) ? link.Url : link.Description)
                </div>

            </a>
        }
    </div>
}

<div class="mt-3">
    <NavLink class="btn btn-outline-primary" href="/downloads">Downloads</NavLink>
</div>

@code {
    private List<ProjectWebsite10032026.Models.Link> links = new();

    protected override async Task OnInitializedAsync()
    {
        await EnsureSeedLinksAsyncSafe();
        await LoadLinks();
    }

    private async Task LoadLinks()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            links = await db.Links
                .AsNoTracking()
                .OrderBy(l => l.Category ?? string.Empty)
                .ThenBy(l => l.Description ?? string.Empty)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load links: {ex.Message}");
            links = new();
        }
    }

    private async Task EnsureSeedLinksAsyncSafe()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            var existingUrls = await db.Links
                .Select(l => l.Url)
                .ToListAsync();

            var entries = new List<ProjectWebsite10032026.Models.Link>
            {
                new()
                {
                    Category = "Guidance",
                    Description = "Bliv godkendt som lærested - Information for schools and companies",
                    Url = "https://iu.dk/skoler-og-virksomheder/oplaering/bliv-godkendt-som-laerested"
                },
                new()
                {
                    Category = "Regulation",
                    Description = "Bekendtgørelse om Data- og kommunikationsuddannelsen",
                    Url = "https://www.retsinformation.dk/eli/lta/2026/182"
                }
            };

            var toAdd = entries
                .Where(e => !existingUrls.Contains(e.Url))
                .ToList();

            if (toAdd.Count > 0)
            {
                db.Links.AddRange(toAdd);
                await db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to seed links: {ex.Message}");
        }
    }
}