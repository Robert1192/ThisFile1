@using ProjectWebsite10032026.Data
@using ProjectWebsite10032026.Models
@page "/"
@using Microsoft.EntityFrameworkCore
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory
@inject Microsoft.Extensions.Logging.ILogger<ProjectWebsite10032026.Components.Pages.Links> Logger

<h3>Links</h3>

<div class="mb-4 add-form">
    <label for="newLink" class="form-label">Add new link</label>
    <div class="input-group">
        <input id="newLink" class="form-control" placeholder="Description" @bind="newLinkDesc" />
        <input class="form-control" placeholder="Url" @bind="newLinkUrl" />
        <button type="button" class="btn btn-primary" @onclick="AddLink" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
            }
            else
            {
                <span>Add</span>
            }
        </button>
    </div>
    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-2 alert alert-info p-2">@message</div>
    }
</div>

<p>List of useful links:</p>

@if (links == null || links.Count == 0)
{
    <p>No links found.</p>
}
else
{
    @foreach (var l in links)
    {
        <div class="card link-card">
            <a href="@l.Url" target="_blank">@l.Description</a>
        </div>
    }
}

<div class="mt-3">
    <NavLink class="btn btn-outline-primary" href="/downloads">Downloads</NavLink>
</div>

@code {
    List<ProjectWebsite10032026.Models.Link> links = new();
    string newLinkDesc = string.Empty;
    string newLinkUrl = string.Empty;
    bool isSaving = false;
    string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadLinks();
    }

    async Task LoadLinks()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            links = await db.Links
                .OrderBy(l => l.Description ?? string.Empty)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load Links from database: {ex.Message}");
            links = new List<ProjectWebsite10032026.Models.Link>();
        }
    }

    async Task AddLink()
    {
        message = string.Empty;
        if (string.IsNullOrWhiteSpace(newLinkDesc) || string.IsNullOrWhiteSpace(newLinkUrl))
        {
            message = "Please fill both fields.";
            return;
        }

        var link = new ProjectWebsite10032026.Models.Link { Description = newLinkDesc, Url = newLinkUrl };
        // optimistic UI update
        links.Insert(0, link);
        StateHasChanged();
        isSaving = true;
        try
        {
            using var db = DbFactory.CreateDbContext();
            db.Links.Add(link);
            await db.SaveChangesAsync();
            newLinkDesc = string.Empty; newLinkUrl = string.Empty;
            message = "Link added.";
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to add link: {ex.Message}");
            // rollback optimistic update
            links.Remove(link);
            message = "Failed to add link. It was not saved to the database.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
