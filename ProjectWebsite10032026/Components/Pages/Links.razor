@using ProjectWebsite10032026.Data
@using ProjectWebsite10032026.Models
@page "/"
@using Microsoft.EntityFrameworkCore
@inject Microsoft.EntityFrameworkCore.IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory
@inject Microsoft.Extensions.Logging.ILogger<ProjectWebsite10032026.Components.Pages.Links> Logger

<h3>Links</h3>

<p>List of useful links:</p>

@if (links == null || links.Count == 0)
{
    <p>No links found.</p>
}
else
{
    @foreach (var l in links)
    {
        <div class="card link-card">
            <a href="@l.Url" target="_blank">@l.Description</a>
        </div>
    }
}

<div class="mt-3">
    <NavLink class="btn btn-outline-primary" href="/downloads">Downloads</NavLink>
</div>

@code {
    List<Link> links = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            links = await db.Links
                .OrderBy(l => l.Description ?? string.Empty)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Failed to load Links from database: {ex.Message}");
            links = new List<Link>();
        }
    }
}
