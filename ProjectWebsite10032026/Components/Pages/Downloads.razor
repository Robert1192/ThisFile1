@page "/downloads"

@using ProjectWebsite10032026.Models
@using ProjectWebsite10032026.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@using PdfSharpCore.Pdf
@using PdfSharpCore.Pdf.IO

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IWebHostEnvironment Env
@inject ILogger<Downloads> Logger

<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h3 class="m-0">Downloads</h3>
    <NavLink class="btn btn-outline-primary" href="/">Links</NavLink>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-@messageType">@message</div>
}

<h5>Upload PDF (merge pages)</h5>
<InputFile OnChange="HandlePdfUpload" multiple />

<hr />

@if (staticFiles.Count > 0)
{
    <h5>Files in /wwwroot/files (Synced)</h5>

    <div class="list-group mb-3">
        @foreach (var f in staticFiles)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@f.FileName</strong>
                </div>

                <a class="btn btn-sm btn-outline-secondary"
                   href="@f.Url"
                   download="@f.FileName">
                    Download
                </a>
            </div>
        }
    </div>
}

@if (downloads == null)
{
    <p>Loading...</p>
}
else if (downloads.Count == 0)
{
    <p>No downloads found.</p>
}
else
{
    <div class="list-group mt-3">
        @foreach (var d in downloads)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center"
                 @key="d.ID">

                <div>
                    <strong>@d.Description</strong>
                    <div class="text-muted small">@d.FileName</div>
                </div>

                <a class="btn btn-sm btn-outline-primary"
                   href="@d.FilePath"
                   download="@d.FileName">
                    Download
                </a>
            </div>
        }
    </div>
}

@code {

    private List<Download> downloads = new();
    private List<StaticFileItem> staticFiles = new();

    private string message = "";
    private string messageType = "info";

    public class StaticFileItem
    {
        public string FileName { get; set; } = "";
        public string Url { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await SyncFilesWithDatabase();
        await LoadDownloads();
        LoadStaticFiles();
    }

    // =========================
    // AUTO SYNC DB ↔ FILES
    // =========================
    private async Task SyncFilesWithDatabase()
    {
        try
        {
            var folder = Path.Combine(Env.WebRootPath!, "files");
            Directory.CreateDirectory(folder);

            var diskFiles = Directory.GetFiles(folder)
                .Select(Path.GetFileName)
                .ToList();

            using var db = DbFactory.CreateDbContext();

            var dbFiles = await db.Downloads
                .Select(x => x.FileName)
                .ToListAsync();

            // 1. Add missing files to DB
            foreach (var file in diskFiles)
            {
                if (file == null) continue;

                if (!dbFiles.Contains(file))
                {
                    db.Downloads.Add(new Download
                    {
                        Description = file,
                        FileName = file,
                        FilePath = $"/files/{file}",
                        CreatedAt = DateTime.UtcNow
                    });
                }
            }

            await db.SaveChangesAsync();

            messageType = "info";
            message = "Files synced successfully.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sync failed");
        }
    }

    // =========================
    // LOAD DB
    // =========================
    private async Task LoadDownloads()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            downloads = await db.Downloads
                .AsNoTracking()
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadDownloads failed");
            downloads = new();
        }
    }

    // =========================
    // LOAD TOP 3 FILES
    // =========================
    private void LoadStaticFiles()
    {
        staticFiles.Clear();

        var path = Path.Combine(Env.WebRootPath!, "files");

        if (!Directory.Exists(path))
            return;

        var files = Directory.GetFiles(path)
            .Select(f => new FileInfo(f))
            .OrderByDescending(f => f.CreationTime)
            .Take(3);

        foreach (var file in files)
        {
            staticFiles.Add(new StaticFileItem
            {
                FileName = file.Name,
                Url = $"/files/{file.Name}"
            });
        }
    }

    // =========================
    // PDF MERGE UPLOAD
    // =========================
    private async Task HandlePdfUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var files = e.GetMultipleFiles();

            if (files.Count == 0)
                return;

            var uploadDir = Path.Combine(Env.WebRootPath!, "files");
            Directory.CreateDirectory(uploadDir);

            using var outputDoc = new PdfDocument();

            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(50_000_000);
                using var ms = new MemoryStream();

                await stream.CopyToAsync(ms);
                ms.Position = 0;

                var inputDoc = PdfReader.Open(ms, PdfDocumentOpenMode.Import);

                foreach (var page in inputDoc.Pages)
                {
                    outputDoc.AddPage(page);
                }
            }

            var fileName = $"merged_{Guid.NewGuid():N}.pdf";
            var fullPath = Path.Combine(uploadDir, fileName);

            outputDoc.Save(fullPath);

            using var db = DbFactory.CreateDbContext();

            var doc = new Download
            {
                Description = "Merged PDF upload",
                FileName = fileName,
                FilePath = $"/files/{fileName}",
                CreatedAt = DateTime.UtcNow
            };

            db.Downloads.Add(doc);
            await db.SaveChangesAsync();

            downloads.Insert(0, doc);

            // Refresh the synced static-files panel so the newly merged
            // PDF actually shows up there instead of silently doing nothing.
            LoadStaticFiles();

            messageType = "success";
            message = "PDF uploaded and merged successfully!";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PDF upload failed");
            messageType = "danger";
            message = "Failed to process PDF.";
        }
    }
}