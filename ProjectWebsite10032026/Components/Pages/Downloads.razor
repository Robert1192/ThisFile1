@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject Microsoft.Extensions.Logging.ILogger<ProjectWebsite10032026.Components.Pages.Links> Logger

@page "/downloads"

<h3>Downloads</h3>

<div class="mb-4 add-form">
    <label class="form-label">Add new document</label>

    <div class="input-group">
        <input class="form-control" placeholder="Description" @bind="newDocDesc" />
        <input class="form-control" placeholder="File path or URL" @bind="newDocPath" />

        <button type="button" class="btn btn-primary" @onclick="AddDoc" disabled="@isSaving">
            @if (isSaving)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <span>Add</span>
            }
        </button>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="mt-2 alert alert-@messageType p-2">@message</div>
    }
</div>

<p>Available downloads (static files in wwwroot/files):</p>

@if (staticFiles.Count == 0)
{
    <p>No static files found in /files.</p>
}
else
{
    @foreach (var f in staticFiles)
    {
        <div class="card link-card p-2 mb-2">
            <a href="@f.Url" target="_blank" download>@f.DisplayName</a>
            <button class="btn btn-sm btn-outline-secondary ms-2"
                    @onclick="async () => await ImportStaticFile(f)">
                Import to DB
            </button>
        </div>
    }
}

<hr />

<p>Downloads from database:</p>

@if (downloads.Count == 0)
{
    <p>No files found.</p>
}
else
{
    @foreach (var item in downloads)
    {
        <div class="card link-card p-2 mb-2">
            <a href="@item.FilePath" target="_blank" download>
                @(string.IsNullOrWhiteSpace(item.FileName) ? item.Description : item.FileName)
            </a>
        </div>
    }
}

<div class="mt-3">
    <NavLink class="btn btn-outline-primary" href="/">Links</NavLink>
</div>

@code {
    private List<ProjectWebsite10032026.Models.Download> downloads = new();
    private List<(string Url, string DisplayName)> staticFiles = new();

    private string newDocDesc = string.Empty;
    private string newDocPath = string.Empty;

    private bool isSaving = false;
    private string message = string.Empty;
    private string messageType = "info";

    protected override async Task OnInitializedAsync()
    {
        await LoadDownloads();
        await LoadStaticFilesAsync();
    }

    private async Task LoadDownloads()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            downloads = await db.Downloads
                .AsNoTracking()
                .OrderBy(d => d.Description ?? string.Empty)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Downloads from database");
            downloads = new();
        }
    }

    private async Task LoadStaticFilesAsync()
    {
        try
        {
            staticFiles.Clear();

            var webRoot = Env.WebRootPath;
            var filesDir = Path.Combine(webRoot ?? ".", "files");

            if (Directory.Exists(filesDir))
            {
                var files = Directory.EnumerateFiles(filesDir)
                    .Where(p => p.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase));

                foreach (var p in files)
                {
                    var name = Path.GetFileName(p);
                    staticFiles.Add((
                        Url: $"/files/{Uri.EscapeDataString(name)}",
                        DisplayName: name
                    ));
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load static files");
        }

        await Task.CompletedTask;
    }

    private async Task ImportStaticFile((string Url, string DisplayName) f)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            var doc = new ProjectWebsite10032026.Models.Download
            {
                Description = f.DisplayName,
                FilePath = f.Url,
                FileName = f.DisplayName
            };

            db.Downloads.Add(doc);
            await db.SaveChangesAsync();

            downloads.Insert(0, doc);

            messageType = "info";
            message = "Imported file to Downloads.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import static file");

            messageType = "danger";
            message = "Failed to import file to database.";
        }
    }

    private async Task AddDoc()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(newDocDesc) ||
            string.IsNullOrWhiteSpace(newDocPath))
        {
            messageType = "danger";
            message = "Please fill both fields.";
            return;
        }

        if (!IsValidPathOrUrl(newDocPath))
        {
            messageType = "danger";
            message = "Invalid URL or file path.";
            return;
        }

        isSaving = true;

        try
        {
            var doc = new ProjectWebsite10032026.Models.Download
            {
                Description = newDocDesc,
                FilePath = newDocPath,
                FileName = Path.GetFileName(newDocPath)
            };

            using var db = DbFactory.CreateDbContext();

            db.Downloads.Add(doc);
            await db.SaveChangesAsync();

            downloads.Insert(0, doc);

            newDocDesc = string.Empty;
            newDocPath = string.Empty;

            messageType = "info";
            message = "Document added.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add document");

            messageType = "danger";
            message = "Failed to add document.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool IsValidPathOrUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return false;

        if (Uri.TryCreate(path, UriKind.Absolute, out var uri))
        {
            return uri.Scheme == Uri.UriSchemeHttp ||
                   uri.Scheme == Uri.UriSchemeHttps ||
                   uri.IsFile;
        }

        return Path.IsPathRooted(path);
    }
}