@page "/downloads"

@using ProjectWebsite10032026.Models
@using ProjectWebsite10032026.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@using PdfSharpCore.Pdf
@using PdfSharpCore.Pdf.IO
@using Microsoft.AspNetCore.Components.Authorization

@inject IDbContextFactory<AppDbContext> DbFactory
@inject IWebHostEnvironment Env
@inject ILogger<Downloads> Logger
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h3 class="m-0">Downloads</h3>
    <NavLink class="btn btn-outline-primary" href="/">Links</NavLink>
</div>

<!-- small status box -->
<div class="d-flex justify-content-end mb-3">
    <div class="card p-2" style="width:220px;">
        <AuthorizeView>
            <Authorized Context="authState">
                <div class="small">Signed in as</div>
                <div class="fw-bold">@authState.User.Identity?.Name</div>
                <div class="mt-2 d-flex justify-content-end">
                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => Navigation.NavigateTo("/logout")'>Logout</button>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="small text-muted">Not signed in</div>
                <div class="mt-2 d-flex justify-content-end">
                    <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo("/login")'>Login</button>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="alert alert-@messageType">@message</div>
}

<AuthorizeView Roles="Admin">
    <Authorized>
        <h5>Upload PDF (merge pages)</h5>
        <InputFile OnChange="HandlePdfUpload" multiple />
    </Authorized>
    <NotAuthorized>
        <div class="d-flex gap-2 align-items-center">
            <h6 class="text-muted m-0">Log in as admin to upload files.</h6>
            <button class="btn btn-sm btn-outline-primary" @onclick='() => Navigation.NavigateTo("/login")'>Log in</button>
        </div>
    </NotAuthorized>
</AuthorizeView>

<hr />

@if (staticFiles.Count > 0)
{
    <h5>Files in /wwwroot/files (Synced)</h5>

    <div class="list-group mb-3">
        @foreach (var f in staticFiles)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@f.FileName</strong>
                </div>

                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary"
                       href="@f.Url"
                       download="@f.FileName">
                        Download
                    </a>

                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteFile(f.FileName)">
                                Delete
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </div>
}

@if (downloads == null)
{
    <p>Loading...</p>
}
else if (downloads.Count == 0)
{
    <p>No downloads found.</p>
}
else
{
    <div class="list-group mt-3">
        @foreach (var d in downloads)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center"
                 @key="d.ID">

                <div>
                    <strong>@d.Description</strong>
                    <div class="text-muted small">@d.FileName</div>
                </div>

                <div class="d-flex gap-2">
                    <a class="btn btn-sm btn-outline-primary"
                       href="@d.FilePath"
                       download="@d.FileName">
                        Download
                    </a>

                    <AuthorizeView Roles="Admin">
                        <Authorized>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteFile(d.FileName)">
                                Delete
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    </div>
}

@code {

    private List<Download> downloads = new();
    private List<StaticFileItem> staticFiles = new();

    private string message = "";
    private string messageType = "info";

    public class StaticFileItem
    {
        public string FileName { get; set; } = "";
        public string Url { get; set; } = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await SyncFilesWithDatabase();
        await LoadDownloads();
        LoadStaticFiles();
    }

    // =========================
    // AUTO SYNC DB ↔ FILES
    // =========================
    private async Task SyncFilesWithDatabase()
    {
        try
        {
            var folder = Path.Combine(Env.WebRootPath!, "files");
            Directory.CreateDirectory(folder);

            var diskFiles = Directory.GetFiles(folder)
                .Select(Path.GetFileName)
                .ToList();

            using var db = DbFactory.CreateDbContext();

            var dbFiles = await db.Downloads
                .Select(x => x.FileName)
                .ToListAsync();

            // 1. Add missing files to DB
            foreach (var file in diskFiles)
            {
                if (file == null) continue;

                if (!dbFiles.Contains(file))
                {
                    db.Downloads.Add(new Download
                    {
                        Description = file,
                        FileName = file,
                        FilePath = $"/files/{file}",
                        CreatedAt = DateTime.UtcNow
                    });
                }
            }

            await db.SaveChangesAsync();

            messageType = "info";
            message = "Files synced successfully.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Sync failed");
        }
    }

    // =========================
    // LOAD DB
    // =========================
    private async Task LoadDownloads()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            downloads = await db.Downloads
                .AsNoTracking()
                .OrderByDescending(x => x.CreatedAt)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "LoadDownloads failed");
            downloads = new();
        }
    }

    // =========================
    // LOAD TOP 3 FILES
    // =========================
    private void LoadStaticFiles()
    {
        staticFiles.Clear();

        var path = Path.Combine(Env.WebRootPath!, "files");

        if (!Directory.Exists(path))
            return;

        var files = Directory.GetFiles(path)
            .Select(f => new FileInfo(f))
            .OrderByDescending(f => f.CreationTime)
            .Take(3);

        foreach (var file in files)
        {
            staticFiles.Add(new StaticFileItem
            {
                FileName = file.Name,
                Url = $"/files/{file.Name}"
            });
        }
    }

    // =========================
    // DELETE A FILE (disk + DB)
    // =========================
    private async Task DeleteFile(string fileName)
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (!user.IsInRole("Admin"))
            {
                messageType = "danger";
                message = "Unauthorized";
                return;
            }
            var folder = Path.Combine(Env.WebRootPath!, "files");
            var fullPath = Path.Combine(folder, fileName);

            if (File.Exists(fullPath))
            {
                File.Delete(fullPath);
            }

            using var db = DbFactory.CreateDbContext();

            var entity = await db.Downloads.FirstOrDefaultAsync(x => x.FileName == fileName);
            if (entity != null)
            {
                db.Downloads.Remove(entity);
                await db.SaveChangesAsync();
            }

            await LoadDownloads();
            LoadStaticFiles();

            messageType = "success";
            message = $"Deleted {fileName}.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete failed");
            messageType = "danger";
            message = "Failed to delete file.";
        }
    }

    // =========================
    // PDF MERGE UPLOAD
    // =========================
    private async Task HandlePdfUpload(InputFileChangeEventArgs e)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (!user.IsInRole("Admin"))
        {
            messageType = "danger";
            message = "Unauthorized";
            return;
        }

        var streams = new List<MemoryStream>();

        try
        {
            var files = e.GetMultipleFiles();

            if (files.Count == 0)
                return;

            var uploadDir = Path.Combine(Env.WebRootPath!, "files");
            Directory.CreateDirectory(uploadDir);

            using var outputDoc = new PdfDocument();

            foreach (var file in files)
            {
                await using var stream = file.OpenReadStream(50_000_000);
                var ms = new MemoryStream();

                await stream.CopyToAsync(ms);
                ms.Position = 0;

                streams.Add(ms);

                var inputDoc = PdfReader.Open(ms, PdfDocumentOpenMode.Import);

                foreach (var page in inputDoc.Pages)
                {
                    outputDoc.AddPage(page);
                }
            }

            // Build a display name and a safe-on-disk file name from the
            // original uploaded file name(s) instead of a generic "Merged" label.
            var originalNames = files.Select(f => f.Name).ToList();

            var description = originalNames.Count == 1
                ? originalNames[0]
                : string.Join(", ", originalNames);

            var baseName = Path.GetFileNameWithoutExtension(originalNames[0]);
            foreach (var invalidChar in Path.GetInvalidFileNameChars())
            {
                baseName = baseName.Replace(invalidChar, '_');
            }

            var uniqueSuffix = Guid.NewGuid().ToString("N")[..8];

            var fileName = originalNames.Count == 1
                ? $"{baseName}_{uniqueSuffix}.pdf"
                : $"{baseName}_merged_{uniqueSuffix}.pdf";

            var fullPath = Path.Combine(uploadDir, fileName);

            outputDoc.Save(fullPath);

            using var db = DbFactory.CreateDbContext();

            var doc = new Download
            {
                Description = description,
                FileName = fileName,
                FilePath = $"/files/{fileName}",
                CreatedAt = DateTime.UtcNow
            };

            db.Downloads.Add(doc);
            await db.SaveChangesAsync();

            downloads.Insert(0, doc);
            LoadStaticFiles();

            messageType = "success";
            message = "PDF uploaded and merged successfully!";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "PDF upload failed");
            messageType = "danger";
            message = "Failed to process PDF.";
        }
        finally
        {
            foreach (var s in streams)
                s.Dispose();
        }
    }

    private Task RunPdfMergeOnLargeStackThread(List<MemoryStream> streams, string outputPath)
    {
        var tcs = new TaskCompletionSource();

        var thread = new Thread(() =>
        {
            try
            {
                using var outputDoc = new PdfDocument();

                foreach (var ms in streams)
                {
                    ms.Position = 0;
                    var inputDoc = PdfReader.Open(ms, PdfDocumentOpenMode.Import);

                    foreach (var page in inputDoc.Pages)
                    {
                        outputDoc.AddPage(page);
                    }
                }

                outputDoc.Save(outputPath);
                tcs.SetResult();
            }
            catch (Exception ex)
            {
                tcs.SetException(ex);
            }
        }, maxStackSize: 64 * 1024 * 1024); // 64 MB, well above the 1MB default

        thread.Start();
        return tcs.Task;
    }
}