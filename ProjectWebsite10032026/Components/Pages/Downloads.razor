@page "/downloads"
@using ProjectWebsite10032026.Models
@using ProjectWebsite10032026.Data
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging
@inject IDbContextFactory<ProjectWebsite10032026.Data.AppDbContext> DbFactory
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject ILogger<Downloads> Logger

<!-- Downloads page -->
<div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
    <h3 class="m-0">Downloads</h3>
</div>

@if (downloads == null)
{
    <p>Loading...</p>
}
else if (downloads.Count == 0)
{
    <p>No downloads found.</p>
}
else
{
    <div class="list-group">
        @foreach (var d in downloads)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <strong>@(string.IsNullOrWhiteSpace(d.Description) ? d.FileName : d.Description)</strong>
                    <div class="text-muted small">@d.FileName</div>
                </div>

                <a class="btn btn-sm btn-outline-primary" href="@d.FilePath" target="_blank" rel="noopener noreferrer">
                    Download
                </a>
            </div>
        }
    </div>
}

@code {
    private List<ProjectWebsite10032026.Models.Download> downloads = new();
    private List<(string Url, string DisplayName)> staticFiles = new();

    private string newDocDesc = string.Empty;
    private string newDocPath = string.Empty;

    private bool isSaving = false;
    private string message = string.Empty;
    private string messageType = "info";

    protected override async Task OnInitializedAsync()
    {
        await LoadDownloads();
        await LoadStaticFilesAsync();
    }

    private async Task LoadDownloads()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            downloads = await db.Downloads
                .AsNoTracking()
                .OrderBy(d => EF.Property<string>(d, nameof(Download.Description)) ?? string.Empty)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load Downloads from database");
            downloads = new();
        }
    }

    private async Task LoadStaticFilesAsync()
    {
        try
        {
            staticFiles.Clear();

            var webRoot = Env.WebRootPath;
            var filesDir = Path.Combine(webRoot ?? ".", "files");

            if (Directory.Exists(filesDir))
            {
                var files = Directory.EnumerateFiles(filesDir)
                    .Where(p => p.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase));

                foreach (var p in files)
                {
                    var name = Path.GetFileName(p);

                    staticFiles.Add((
                        Url: $"/files/{Uri.EscapeDataString(name)}",
                        DisplayName: name
                    ));
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load static files");
        }

        await Task.CompletedTask;
    }

    private Task ImportStaticFileHandler((string Url, string DisplayName) f)
        => ImportStaticFile(f);

    private async Task ImportStaticFile((string Url, string DisplayName) f)
    {
        try
        {
            using var db = DbFactory.CreateDbContext();

            var doc = new ProjectWebsite10032026.Models.Download
            {
                Description = f.DisplayName,
                FilePath = f.Url,
                FileName = f.DisplayName
            };

            db.Downloads.Add(doc);
            await db.SaveChangesAsync();

            downloads.Insert(0, doc);

            messageType = "info";
            message = "Imported file to Downloads.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to import static file");

            messageType = "danger";
            message = "Failed to import file to database.";
        }
    }

    private async Task AddDoc()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(newDocDesc) ||
            string.IsNullOrWhiteSpace(newDocPath))
        {
            messageType = "danger";
            message = "Please fill both fields.";
            return;
        }

        if (!IsValidPathOrUrl(newDocPath))
        {
            messageType = "danger";
            message = "Invalid URL or file path.";
            return;
        }

        isSaving = true;

        try
        {
            var doc = new ProjectWebsite10032026.Models.Download
            {
                Description = newDocDesc,
                FilePath = newDocPath,
                FileName = Path.GetFileName(newDocPath)
            };

            using var db = DbFactory.CreateDbContext();

            db.Downloads.Add(doc);
            await db.SaveChangesAsync();

            downloads.Insert(0, doc);

            newDocDesc = string.Empty;
            newDocPath = string.Empty;

            messageType = "info";
            message = "Document added.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to add document");

            messageType = "danger";
            message = "Failed to add document.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private bool IsValidPathOrUrl(string path)
    {
        if (string.IsNullOrWhiteSpace(path)) return false;

        if (Uri.TryCreate(path, UriKind.Absolute, out var uri))
        {
            return uri.Scheme == Uri.UriSchemeHttp ||
                   uri.Scheme == Uri.UriSchemeHttps ||
                   uri.IsFile;
        }

        return Path.IsPathRooted(path);
    }
}